rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() {
      return request.auth != null;
    }
    function saya() {
      return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data;
    }
    function ahli(sid) {
      return masuk() && saya().sekolahId == sid;
    }
    function admin(sid) {
      return ahli(sid) && saya().peranan == 'admin';
    }

    // Profil pengguna — setiap orang urus profil sendiri sahaja
    match /pengguna/{uid} {
      allow read, create, update: if masuk() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Dokumen sekolah — sesiapa yang log masuk boleh baca (untuk semak kod semasa daftar),
    // hanya pentadbir sekolah itu boleh ubah.
    match /sekolah/{sid} {
      allow read:   if masuk();
      allow create: if masuk();
      allow update: if admin(sid);
      allow delete: if false;

      // Laporan — hanya ahli sekolah. Guru boleh ubah laporan sendiri,
      // pentadbir boleh ubah semua.
      match /laporan/{id} {
        allow read:   if ahli(sid);
        allow create: if ahli(sid) && request.resource.data.olehUid == request.auth.uid;
        allow update, delete: if ahli(sid) &&
          (resource.data.olehUid == request.auth.uid || admin(sid));
      }
    }
  }
}
