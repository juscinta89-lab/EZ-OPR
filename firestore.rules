rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function masuk()      { return request.auth != null; }
    function sekolahDoc(sid) { return get(/databases/$(database)/documents/sekolah/$(sid)).data; }
    function saya()       { return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data; }
    function ahli(sid)    { return masuk() && saya().sekolahId == sid; }
    function admin(sid)   { return ahli(sid) && saya().peranan == 'admin'; }

    // ---------- Profil guru ----------
    // Guru hanya boleh menyertai sekolah yang wujud DAN masih membuka pendaftaran,
    // atau sekolah yang baru dicipta sendiri.
    match /pengguna/{uid} {
      allow read, update, delete: if masuk() && request.auth.uid == uid;
      allow create: if masuk() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/sekolah/$(request.resource.data.sekolahId))
        && (
             sekolahDoc(request.resource.data.sekolahId).terbuka == true
          || sekolahDoc(request.resource.data.sekolahId).pemilik == request.auth.uid
        );
    }

    // ---------- Sekolah ----------
    match /sekolah/{sid} {
      // Baca dibenarkan supaya kod sekolah boleh disemak semasa menyertai.
      allow read:   if masuk();
      // Cipta hanya untuk diri sendiri sebagai pemilik. Kod yang sudah wujud
      // tidak boleh ditulis ganti kerana 'create' hanya sah bagi dokumen baharu.
      allow create: if masuk() && request.resource.data.pemilik == request.auth.uid;
      allow update: if admin(sid) && request.resource.data.pemilik == resource.data.pemilik;
      allow delete: if false;

      // ---------- Laporan ----------
      match /laporan/{id} {
        allow read:   if ahli(sid);
        allow create: if ahli(sid) && request.resource.data.olehUid == request.auth.uid;
        allow update, delete: if ahli(sid) &&
          (resource.data.olehUid == request.auth.uid || admin(sid));
      }
    }
  }
}
